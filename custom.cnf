[mysqld]
# Optimize memory usage for high concurrency (assuming 1GB+ RAM)
# Ideally 70-80% of available RAM
innodb_buffer_pool_size = 768M 
innodb_redo_log_capacity = 512M
# host_cache_size replaces deprecated --skip-host-cache
host_cache_size = 0
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_thread_concurrency = 0

# Connection limits
max_connections = 100
max_allowed_packet = 64M
wait_timeout = 28800
interactive_timeout = 28800

# Performance Schema (optional: disable if memory is very low)
# performance_schema = OFF

# Slow Query log for optimization tasks
slow_query_log = 1
long_query_time = 1
log_output = FILE
slow_query_log_file = /var/log/mysql/slow-query.log

# Character Set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
